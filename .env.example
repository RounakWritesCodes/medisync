# MediSync Environment Configuration
# Copy to .env: cp .env.example .env

# Core Database
DATABASE_URL=postgresql://medisync:medisync_dev@localhost:5432/medisync
POSTGRES_PASSWORD=medisync_dev

# Session & Security
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The API refuses to start in production with a missing or default secret.
SESSION_SECRET=replace-with-a-random-64-char-string
# HTTPS-only cookies; defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# Web frontend
# Public base URL used to build email verification / reset links.
APP_URL=http://localhost:3000

# API Configuration
CORS_ORIGIN=http://localhost:3000
API_PORT=3001
NODE_ENV=development

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=medisync
S3_SECRET_KEY=medisync_dev
S3_BUCKET=medisync
S3_REGION=us-east-1

# Web frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# AI diagnosis (local Python AI service — no external API key needed)
# AI_BASE_URL=http://ai-service:8000
# AI_MOCK=true

# Resend email verification (optional)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=MediSync <noreply@yourdomain.com>
# EMAIL_VERIFICATION_ENABLED=false
# VERIFICATION_TOKEN_EXPIRY_MINUTES=60

# pgAdmin (tools profile)
# PGADMIN_EMAIL=admin@medisync.local
# PGADMIN_PASSWORD=admin
